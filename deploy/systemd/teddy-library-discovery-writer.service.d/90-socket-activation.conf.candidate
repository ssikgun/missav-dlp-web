# DWS-001 review-only service drop-in; DO NOT install.
# Clear service-owned directory to prevent cleanup of systemd-owned socket.
[Unit]
Requires=teddy-library-discovery-writer.socket
After=teddy-library-discovery-writer.socket

[Service]
RuntimeDirectory=
RuntimeDirectoryPreserve=no
