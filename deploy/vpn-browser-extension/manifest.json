{
  "manifest_version": 3,
  "name": "Teddy Downloader",
  "version": "1.0.0",
  "description": "현재 활성 탭 URL을 Teddy Downloader 큐에 추가합니다.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://missav-dlp-web/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "현재 페이지 다운로드"
  }
}
