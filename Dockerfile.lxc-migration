# LXC migration canary image.
#
# Build on the exact production Teddy image that CT108 is replacing, then apply
# only the migration overlays proven on the dedicated LXC. This keeps the NAS
# production image/tag untouched while migration behavior is validated.
FROM ghcr.io/ssikgun/missav-dlp-web:teddy-db25e08af9e31d23dd1eaf353db4e30dc7b48c7c

WORKDIR /app

COPY teddy_storage.py /app/teddy_storage.py
COPY teddy_patch_split_storage.py /app/teddy_patch_split_storage.py
COPY teddy_browser_config.py /app/teddy_browser_config.py
COPY teddy_patch_browser_runtime.py /app/teddy_patch_browser_runtime.py
COPY templates/teddy-browser.js /app/templates/teddy-browser.js
COPY templates/teddy-network.css /app/templates/teddy-network.css

RUN python -m py_compile \
        teddy_storage.py teddy_patch_split_storage.py \
        teddy_browser_config.py teddy_patch_browser_runtime.py && \
    python teddy_patch_split_storage.py && \
    python teddy_patch_browser_runtime.py && \
    python -m py_compile \
        teddy_storage.py teddy_generic.py teddy_entrypoint.py teddy_bootstrap.py \
        teddy_browser_config.py

# Migration-specific semantic guards. The legacy /downloads root remains the
# local work/state root; only completed public files use TEDDY_FINAL_DIR.
# Browser embedding keeps the proven LAN fallback while allowing an explicit
# HTTPS reverse-proxy URL through TEDDY_BROWSER_URL.
RUN grep -Fq "TEDDY_FINAL_DIR" teddy_storage.py && \
    grep -Fq "local_result_path" teddy_generic.py && \
    grep -Fq "local_result_path" teddy_entrypoint.py && \
    grep -Fq "error_kind') == 'storage'" teddy_bootstrap.py && \
    grep -Fq "Final directory:" teddy_bootstrap.py && \
    grep -Fq "teddy_browser_config.install(core)" teddy_bootstrap.py && \
    grep -Fq "TEDDY_BROWSER_URL" teddy_browser_config.py && \
    grep -Fq "/api/browser/config" templates/teddy-browser.js && \
    grep -Fq "width: 100%" templates/teddy-network.css

RUN mkdir -p /downloads /final
